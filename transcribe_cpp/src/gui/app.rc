// Windows resources: program icon and version information.
// IDI_ICON1 is also picked up by Qt as the default window icon.
#include <winver.h>

IDI_ICON1 ICON "transcribe.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "David Vickers"
            VALUE "FileDescription",  "Transcribe - local speech-to-text"
            VALUE "FileVersion",      "1.1.0"
            VALUE "ProductName",      "Transcribe"
            VALUE "ProductVersion",   "1.1.0"
            VALUE "LegalCopyright",   "Uses CrispASR and ggml (MIT) and Qt (LGPL)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
